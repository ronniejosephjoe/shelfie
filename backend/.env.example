# Copy to .env and fill in. Nothing here is required to run the app in
# mock mode (VLM_PROVIDER=mock is the default).

# "openai" | "gemini" | "mock" -- mock is a deterministic offline
# stand-in (see scanner/services/vlm_client.py). gemini is the
# no-credit-card option: get a free key at aistudio.google.com.
VLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
# Set true only once you've enabled billing on the Google account --
# free-tier calls are $0 regardless of this flag.
GEMINI_BILLING_ENABLED=false

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-secret-key-not-for-production

# Confidence thresholds, see catalog/matching.py
MATCH_AUTO_ACCEPT_THRESHOLD=0.86
MATCH_REVIEW_THRESHOLD=0.55
